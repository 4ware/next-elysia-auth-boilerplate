# All variables below are validated at startup by @myapp/env (packages/env),
# powered by t3-env + Zod. A missing or malformed required variable throws a
# clear error immediately instead of failing confusingly deep inside
# better-auth, Drizzle, or the Elysia app at request time.
#
# To skip validation entirely (e.g. CI steps that don't need the full env,
# like `drizzle-kit generate`), set SKIP_ENV_VALIDATION=1.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/myapp"

# ─── better-auth ─────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET="generate-a-strong-secret-with-openssl-rand-base64-32"
# Elysia + better-auth run in-process inside Next.js, so this is the web app's
# own origin (NOT a separate API port).
BETTER_AUTH_URL="http://localhost:3000"

# ─── Google OAuth (optional) ───────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Apple OAuth (optional) ────────────────────────────────────────────────────
# developer.apple.com → Certificates, Identifiers & Profiles
# Redirect URI: http://localhost:3000/api/auth/callback/apple
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# ─── WebAuthn / Passkeys ──────────────────────────────────────────────────────
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="MyApp"
WEBAUTHN_ORIGIN="http://localhost:3000"

# ─── App URLs ─────────────────────────────────────────────────────────────────
WEB_URL="http://localhost:3000"

# NEXT_PUBLIC_API_URL is only needed if you point the web app at the
# standalone apps/api deployment instead of the in-process Elysia mount.
# Leave unset to use same-origin relative paths (the default and recommended setup).
# Must be set with the NEXT_PUBLIC_ prefix to be readable in client-side code —
# see packages/env/src/nextjs.ts.
# NEXT_PUBLIC_API_URL="http://localhost:3001"

# Only used by the optional standalone apps/api server
PORT=3001

NODE_ENV="development"

# Set to "1" to bypass @myapp/env validation entirely (useful for partial CI
# steps or scripts that don't need the full variable set).
# SKIP_ENV_VALIDATION="1"

# ─── E2E Testing ──────────────────────────────────────────────────────────────
# A pre-seeded account for Playwright tests (create via db seed or manually)
TEST_USER_EMAIL="e2e@example.com"
TEST_USER_PASSWORD="password123"
